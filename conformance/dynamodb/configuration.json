      "initialization": {
        "expect": {
          "result": "success"
        },
        "observe": {
          "requests": [
            {
              "api": "BatchGetItem",
              "phase": "configuration-read",
              "constraints": {
                "keys": [
                  "journal:__config__:0",
                  "snapshot:__config__:0",
                  "head:__config__"
