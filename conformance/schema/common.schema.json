{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/json"
          }
        }
      ]
    },
    "aggregate-id": {
      "type": "object",
      "properties": {
        "type_name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type_name",
        "value"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "optimistic-lock",
            "contract-violation",
            "serialization",
            "configuration",
            "storage"
          ]
        },
        "rule": {
          "type": "string",
          "pattern": "^(T|H|W|R|E|S|SP|DY|D)-[1-9][0-9]*$"
        },
        "message": {
          "type": "object",
          "properties": {
            "must_contain": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "must_not_contain": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "context_only": {
              "type": "object",
              "properties": {
                "aid": {
                  "type": "string"
                },
                "attempted_seq_nr": {
                  "type": "integer"
                },
                "head_seq_nr": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "aid",
                "attempted_seq_nr",
                "head_seq_nr"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "must_contain",
            "must_not_contain"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "category",
        "message"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "aggregate_id": {
          "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/aggregate-id"
        },
        "seq_nr": {
          "type": "integer"
        },
        "occurred_at": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        },
        "payload": {
          "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/json"
        }
      },
      "required": [
        "aggregate_id",
        "seq_nr",
        "occurred_at",
        "payload"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "aggregate": {
          "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/json"
        },
        "seq_nr": {
          "type": "integer"
        },
        "manifest": {
          "type": "string"
        }
      },
      "required": [
        "aggregate",
        "seq_nr"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(T|H|W|R|E|S|SP|DY|D)-[1-9][0-9]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": {
          "type": "string"
        },
        "backends": {
          "type": "array",
          "items": {
            "enum": [
              "memory",
              "dynamodb"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requires": {
          "type": "array",
          "items": {
            "enum": [
              "ttl"
            ]
          }
        },
        "store": {
          "type": "object",
          "properties": {
            "retention_count": {
              "type": [
                "integer",
                "null"
              ]
            },
            "retention_mode": {
              "enum": [
                "delete",
                "ttl"
              ]
            },
            "ttl_grace_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "layout_version": {
              "const": 1
            },
            "retry_limit": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "retention_count",
            "retention_mode"
          ],
          "additionalProperties": false
        },
        "initialization": {
          "type": "object",
          "properties": {
            "expect": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "result": {
                      "enum": [
                        "success"
                      ]
                    }
                  },
                  "required": [
                    "result"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/error"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "observe": {
              "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/observe"
            }
          },
          "required": [
            "expect"
          ],
          "additionalProperties": false
        },
        "fixtures": {
          "type": "object",
          "properties": {
            "events": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "aggregate_id": {
                    "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/aggregate-id"
                  },
                  "seq_nr": {
                    "type": "integer"
                  },
                  "occurred_at": {
                    "type": "string"
                  },
                  "manifest": {
                    "type": "string"
                  },
                  "payload": {
                    "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/json"
                  }
                },
                "required": [
                  "aggregate_id",
                  "seq_nr",
                  "occurred_at",
                  "payload"
                ],
                "additionalProperties": false
              }
            },
            "snapshots": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "aggregate": {
                    "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/json"
                  },
                  "seq_nr": {
                    "type": "integer"
                  },
                  "manifest": {
                    "type": "string"
                  }
                },
                "required": [
                  "aggregate",
                  "seq_nr"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "events",
            "snapshots"
          ],
          "additionalProperties": false
        },
        "seed": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/item"
              }
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        "clock": {
          "type": "object",
          "properties": {
            "epoch_seconds": {
              "type": "integer"
            }
          },
          "required": [
            "epoch_seconds"
          ],
          "additionalProperties": false
        },
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "phase": {
                "enum": [
                  "serialize-event",
                  "serialize-snapshot",
                  "deserialize-event",
                  "deserialize-snapshot",
                  "commit",
                  "read-events",
                  "read-snapshot",
                  "retention-query",
                  "retention-delete",
                  "retention-mark",
                  "configuration-read",
                  "configuration-create"
                ]
              },
              "kind": {
                "enum": [
                  "storage-error",
                  "serialization-error",
                  "sdk-error",
                  "sdk-response",
                  "read-interleave"
                ]
              },
              "times": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "const": "until-operation-finishes"
                  }
                ]
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/json"
                }
              }
            },
            "required": [
              "operation",
              "phase",
              "kind",
              "times",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/step"
          }
        },
        "representation": {
          "type": "object",
          "properties": {
            "time_precision": {
              "enum": [
                "nanoseconds",
                "milliseconds"
              ]
            },
            "signed_seq_nr": {
              "const": true
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "id",
        "rules",
        "description",
        "backends",
        "store",
        "fixtures",
        "steps"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "table": {
          "enum": [
            "journal",
            "snapshot",
            "head"
          ]
        },
        "attributes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "S",
              "N",
              "B",
              "L",
              "M"
            ]
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/json"
          }
        },
        "binary_json": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/json"
          }
        },
        "nested_attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "enum": [
                "S",
                "N",
                "B",
                "L",
                "M"
              ]
            }
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "table",
        "attributes",
        "values"
      ],
      "additionalProperties": false
    },
    "observe": {
      "type": "object",
      "properties": {
        "history": {
          "type": "object",
          "properties": {
            "active": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "uniqueItems": true
            },
            "marked": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "seq_nr": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "ttl": {
                    "type": "integer"
                  }
                },
                "required": [
                  "seq_nr",
                  "ttl"
                ],
                "additionalProperties": false
              }
            },
            "absent": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "uniqueItems": true
            }
          },
          "required": [
            "active",
            "marked",
            "absent"
          ],
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/item"
          }
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "api": {
                "enum": [
                  "BatchGetItem",
                  "TransactWriteItems",
                  "Query",
                  "BatchWriteItem",
                  "UpdateItem"
                ]
              },
              "phase": {
                "type": "string"
              },
              "constraints": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/json"
                }
              }
            },
            "required": [
              "api",
              "phase",
              "constraints"
            ],
            "additionalProperties": false
          }
        },
        "notifications": {
          "type": "array",
          "items": {
            "enum": [
              "retention-failure"
            ]
          }
        },
        "no_requests_in_phases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request_count": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "minimum_request_count": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "result": {
              "enum": [
                "success"
              ]
            }
          },
          "required": [
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "enum": [
                "none"
              ]
            }
          },
          "required": [
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "enum": [
                "snapshot"
              ]
            },
            "head_seq_nr": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "snapshot": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "result",
            "head_seq_nr",
            "snapshot"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "enum": [
                "events"
              ]
            },
            "events": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            }
          },
          "required": [
            "result",
            "events"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "persistEvent"
              ]
            },
            "arguments": {
              "type": "object",
              "properties": {
                "event": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            "expect": {
              "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/result"
            },
            "observe": {
              "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/observe"
            },
            "clock_epoch_seconds": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "arguments",
            "expect"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "persistEventAndSnapshot"
              ]
            },
            "arguments": {
              "type": "object",
              "properties": {
                "event": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "snapshot": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                }
              },
              "required": [
                "event",
                "snapshot"
              ],
              "additionalProperties": false
            },
            "expect": {
              "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/result"
            },
            "observe": {
              "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/observe"
            },
            "clock_epoch_seconds": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "arguments",
            "expect"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "getLatestSnapshotById"
              ]
            },
            "arguments": {
              "type": "object",
              "properties": {
                "aggregate_id": {
                  "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/aggregate-id"
                }
              },
              "required": [
                "aggregate_id"
              ],
              "additionalProperties": false
            },
            "expect": {
              "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/result"
            },
            "observe": {
              "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/observe"
            },
            "clock_epoch_seconds": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "arguments",
            "expect"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "getEventsByIdSinceSeqNr"
              ]
            },
            "arguments": {
              "type": "object",
              "properties": {
                "aggregate_id": {
                  "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/aggregate-id"
                },
                "seq_nr": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "aggregate_id",
                "seq_nr"
              ],
              "additionalProperties": false
            },
            "expect": {
              "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/result"
            },
            "observe": {
              "$ref": "https://j5ik2o.github.io/event-store-adapter/conformance/schema/common.schema.json#/$defs/observe"
            },
            "clock_epoch_seconds": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "arguments",
            "expect"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
